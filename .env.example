# Copy to .env and fill in. Never commit .env. All values below are placeholders.

# --- Execution safety ---------------------------------------------------------
# PAPER (default) simulates fills. LIVE sends real transactions.
EXECUTION_MODE=PAPER
# Must be exactly "true" for LIVE mode to start. Anything else is treated as false.
LIVE_TRADING_ENABLED=false
# Per-position caps. LIVE mode requires at least one of these to be > 0.
MAX_POSITION_SOL=0
MAX_POSITION_USD=0

# --- Chain access ---------------------------------------------------------------
# Required in every mode.
SOLANA_RPC_URL=https://your-rpc-provider.example/rpc
# Required only in LIVE mode. Base58-encoded secret key. Leave empty for PAPER.
WALLET_PRIVATE_KEY=

# --- Optional signal providers ------------------------------------------------
# LLM/social signals are advisory only and can never bypass on-chain safety gates.
LLM_API_KEY=

# Grok (xAI) social signal analyzer. Off unless GROK_ENABLED is exactly "true".
# When enabled, XAI_API_KEY is required and startup fails without it.
GROK_ENABLED=false
XAI_API_KEY=
# Cheap triage model for every candidate.
GROK_MODEL=grok-4.1-fast
# Stronger model, only for candidates that passed every on-chain gate AND the volume threshold.
GROK_ESCALATION_MODEL=grok-4.7
GROK_ESCALATION_MIN_VOLUME_USD=50000
# Hard per-call deadline. On timeout or 429 the analyzer returns "watch" with confidence 0.
GROK_TIMEOUT_MS=3500
# Duplicate alerts for the same token within this window reuse the cached result.
GROK_CACHE_TTL_SEC=300
# Max agentic x_search turns per request.
GROK_MAX_TOOL_TURNS=2

# --- Misc -----------------------------------------------------------------------
LOG_LEVEL=info
