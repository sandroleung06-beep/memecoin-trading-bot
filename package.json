{
  "name": "memecoin-trading-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Modular meme coin trading bot with deterministic safety gates (paper trading by default).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "risk:reset": "node dist/risk/resetCli.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  }
}
